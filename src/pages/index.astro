---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import AppCard from '../components/AppCard.astro';
import Craft from '../components/Craft.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import { getProjects } from '../data/projects';
import { SITE } from '../data/site';

const projects = await getProjects();
---

<Base>
  <Hero projects={projects} />

  <!-- Apps -->
  <section id="apps" class="wrap scroll-mt-24 py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Apps</p>
        <h2 class="h-display mt-3 text-4xl sm:text-5xl">Shipped, and still running.</h2>
        <p class="mt-4 text-lg text-muted">From a campus delivery fleet on the App Store and Google Play to price data for every Filipino city.</p>
      </div>
      <a href="/projects" class="text-sm font-semibold underline-offset-4 hover:underline">All apps →</a>
    </div>
    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      {projects.map((p) => <AppCard project={p} />)}
    </div>
  </section>

  <Craft projects={projects} />
  <Experience />
  <Skills projects={projects} />

  <!-- Contact band -->
  <section class="wrap py-10">
    <div class="relative overflow-hidden rounded-[2rem] bg-[#0a0a0c] px-6 py-14 text-white sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-indigo-500 opacity-30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-28 left-10 size-72 rounded-full bg-rose-500 opacity-20 blur-3xl"></div>
      <p class="relative font-mono text-xs tracking-[0.14em] text-white/60 uppercase">Contact</p>
      <h2 class="h-display relative mt-3 max-w-2xl text-4xl sm:text-5xl">Have an app to build, or one to rescue? Let's talk.</h2>
      <p class="relative mt-4 max-w-xl text-white/70">
        New builds, store releases, backends that need to scale, or a team that needs a mobile engineer. I usually reply within
        a day or two.
      </p>
      <div class="relative mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn bg-white text-stone-900 hover:bg-accent hover:text-white">Send a message</a>
        <a href={`mailto:${SITE.email}`} class="btn border border-white/25 hover:border-white">{SITE.email}</a>
      </div>
    </div>
  </section>
</Base>
