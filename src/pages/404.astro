---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="h-display mt-3 text-5xl sm:text-6xl">This page doesn't exist.</h1>
    <p class="mt-4 text-lg text-muted">It may have moved. The projects are a good place to start.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/projects" class="btn-ghost">Projects</a>
    </div>
  </section>
</Base>
