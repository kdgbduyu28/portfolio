---
import { SITE } from '../data/site';

// The form posts to functions/api/contact.ts. Without a Turnstile site key at build time the form
// is replaced by a plain email link, since the function refuses messages it can't verify.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

{
  siteKey ? (
    <form class="space-y-5" data-contact data-email={SITE.email} novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Your name</span>
          <input name="name" required maxlength="100" autocomplete="name" class="field" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input name="email" type="email" required maxlength="200" autocomplete="email" class="field" />
        </label>
      </div>
      <label class="block">
        <span class="text-sm font-medium">What would you like to talk about?</span>
        <select name="topic" class="field">
          <option>A project for my business</option>
          <option>A job or role</option>
          <option>Collaborating</option>
          <option>Something else</option>
        </select>
      </label>
      <label class="block">
        <span class="text-sm font-medium">Message</span>
        <textarea name="message" required minlength="10" maxlength="5000" rows="6" class="field resize-y" />
      </label>
      {/* Bots fill every field; people never see this one. */}
      <label class="absolute -left-[9999px]" aria-hidden="true">
        Leave this empty
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible" />
      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" class="btn-primary disabled:opacity-60" data-submit>
          Send message
        </button>
        <p class="text-sm" role="status" aria-live="polite" data-status />
      </div>
      {/* Shown only when sending fails, so the visitor's message isn't lost. */}
      <div hidden data-fallback>
        <a class="btn-ghost" data-fallback-link>Email it instead</a>
      </div>
    </form>
  ) : (
    <div class="rounded-2xl border border-line bg-card p-6">
      <p class="font-semibold">Email me directly</p>
      <p class="mt-1 text-sm text-muted">The contact form isn't switched on yet.</p>
      <a href={`mailto:${SITE.email}`} class="btn-primary mt-5">
        {SITE.email}
      </a>
    </div>
  )
}

<style>
  @reference '../styles/global.css';
  .field {
    @apply mt-1.5 block w-full rounded-xl border border-line bg-card px-3.5 py-2.5 text-base text-ink transition outline-none placeholder:text-muted focus:border-accent focus:ring-4 focus:ring-accent/15;
  }
  .field[aria-invalid='true'] {
    @apply border-rose-500;
  }
</style>

<script>
  type Turnstile = { render: (el: HTMLElement, opts: Record<string, string>) => void; reset: () => void };

  function setup() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';

    // Load Turnstile once, then render the widget explicitly. That works the same on a full page load
    // and after an in-app page transition.
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');
    if (widget) {
      const render = () => {
        const ts = (window as unknown as { turnstile?: Turnstile }).turnstile;
        if (!ts) return void setTimeout(render, 150);
        if (!widget.dataset.rendered) {
          widget.dataset.rendered = '1';
          ts.render(widget, { sitekey: widget.dataset.sitekey!, theme: 'auto', size: 'flexible' });
        }
      };
      if (!document.querySelector('script[data-turnstile]')) {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.dataset.turnstile = '';
        document.head.appendChild(script);
      }
      render();
    }

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const loadedAt = Date.now();
    const fallback = form.querySelector<HTMLElement>('[data-fallback]')!;
    const fallbackLink = form.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
    const say = (text: string, ok: boolean) => {
      status.textContent = text;
      status.className = `text-sm ${ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.setAttribute('aria-invalid', String(bad));
        valid &&= !bad;
      });
      if (!valid) return say('Please fill in your name, a valid email and a message.', false);

      const body = Object.fromEntries(new FormData(form)) as Record<string, string>;
      // How long the visitor spent on the form. Bots submit instantly; the server drops those.
      body.elapsed = String(Date.now() - loadedAt);
      fallback.hidden = true;
      submit.disabled = true;
      say('Sending…', true);
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) throw new Error(data.error ?? 'Something went wrong.');
        form.reset();
        say("Thanks! Your message is on its way. I'll reply by email.", true);
      } catch (err) {
        say(`${(err as Error).message} Your message is still here; you can email it instead.`, false);
        // Open the visitor's mail app with their message already written.
        const subject = `Portfolio: ${body.topic} from ${body.name}`;
        const text = `${body.message}\n\n— ${body.name} <${body.email}>`;
        fallbackLink.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
        fallback.hidden = false;
      } finally {
        submit.disabled = false;
        // A Turnstile token works once; get a fresh one for the next try.
        (window as unknown as { turnstile?: Turnstile }).turnstile?.reset();
      }
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
