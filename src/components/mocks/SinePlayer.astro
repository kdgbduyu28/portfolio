---
// Drawn Sine player on a TV: a film frame with the info overlay open. Illustration with a made-up title.

const chips = [
  { k: 'Video', v: 'Dolby Vision · Profile 8.1' },
  { k: 'Audio', v: 'TrueHD Atmos 7.1 · Passthrough' },
  { k: 'Subtitles', v: 'English · PGS' },
  { k: 'Display', v: '3840×2160 · 23.976 Hz' },
];
---

<div class="p" role="img" aria-label="Illustration of the Sine player showing Dolby Vision, Atmos passthrough and PGS subtitles, sample data">
  <!-- the "film": a drawn dusk seascape -->
  <div class="scene" aria-hidden="true">
    <span class="sun"></span>
    <span class="sea"></span>
    <span class="boat"></span>
  </div>

  <p class="sub">We should leave before the tide turns.</p>

  <span class="engine">Media3 · hardware decoder</span>

  <div class="osd">
    <div class="top">
      <div>
        <p class="title">The Long Monsoon</p>
        <p class="file">The.Long.Monsoon.2160p.UHD.Remux.DV.TrueHD.Atmos.mkv · Media NAS</p>
      </div>
      <span class="time">1:12:40 / 1:58:03</span>
    </div>
    <span class="bar"><i></i><b></b></span>
    <ul>
      {
        chips.map((c) => (
          <li>
            <span>{c.k}</span>
            {c.v}
          </li>
        ))
      }
    </ul>
  </div>
  <span class="tag">Sample data</span>
</div>

<style>
  .p {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-family: 'Inter', system-ui, sans-serif;
    color: #f4f1ea;
    background: #000;
  }
  .scene {
    position: absolute;
    inset: 0;
    background: linear-gradient(#1b2340 0%, #6b3a52 38%, #e08a5c 56%, #2a3550 57%, #0d1424 100%);
  }
  .sun {
    position: absolute;
    left: 58%;
    top: 40%;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe2a8 0%, #f6a66a 45%, transparent 70%);
  }
  .sea {
    position: absolute;
    inset: 57% 0 0;
    background: repeating-linear-gradient(180deg, rgb(255 210 160 / 0.12) 0 2px, transparent 2px 14px);
    mask: linear-gradient(90deg, transparent 30%, #000 60%, transparent 90%);
  }
  .boat {
    position: absolute;
    left: 28%;
    top: 53%;
    width: 70px;
    height: 18px;
    background: #0b0f1c;
    clip-path: polygon(0 40%, 100% 40%, 85% 100%, 12% 100%);
  }
  .sub {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 196px;
    text-align: center;
    font-size: 24px;
    font-weight: 600;
    color: #fff;
    text-shadow:
      0 0 3px #000,
      0 2px 4px #000;
  }
  .engine {
    position: absolute;
    top: 22px;
    right: 24px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    background: rgb(14 13 16 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .osd {
    position: absolute;
    inset: auto 0 0;
    padding: 70px 40px 28px;
    background: linear-gradient(transparent, rgb(8 7 10 / 0.92) 45%);
  }
  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .file {
    margin-top: 4px;
    font-size: 12px;
    color: #a9a3b0;
  }
  .time {
    flex: none;
    font-size: 14px;
    color: #a9a3b0;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    position: relative;
    display: block;
    height: 5px;
    margin: 14px 0 16px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.18);
  }
  .bar i {
    position: absolute;
    inset: 0 39% 0 0;
    border-radius: 3px;
    background: #f5c451;
  }
  .bar b {
    position: absolute;
    left: 61%;
    top: 50%;
    width: 15px;
    height: 15px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #f5c451;
    box-shadow: 0 0 0 4px rgb(245 196 81 / 0.25);
  }
  ul {
    display: flex;
    gap: 10px;
  }
  li {
    display: grid;
    gap: 2px;
    padding: 9px 14px;
    border-radius: 10px;
    font-size: 13px;
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  li span {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5c451;
  }
  .tag {
    position: absolute;
    top: 26px;
    left: 24px;
    font-size: 11px;
    color: rgb(255 255 255 / 0.4);
  }
</style>
