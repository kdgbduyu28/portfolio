---
// Drawn D-Touch front-desk status board for a tablet. Made-up patients and times.

const columns = [
  {
    title: 'Confirmed',
    tone: 'bg-sky-50 text-sky-700',
    cards: [
      { n: 'Paolo Garcia', s: 'Extraction', t: '1:00' },
      { n: 'Bea Mendoza', s: 'Whitening', t: '2:00' },
    ],
  },
  { title: 'Arrived', tone: 'bg-amber-50 text-amber-800', cards: [{ n: 'Liza Bautista', s: 'Braces adjustment', t: '11:15', late: '5 min wait' }] },
  { title: 'In consultation', tone: 'bg-teal-50 text-teal-800', cards: [{ n: 'Marco Santos', s: 'Check-up', t: '10:30', active: true }] },
  {
    title: 'Completed',
    tone: 'bg-stone-100 text-stone-500',
    cards: [
      { n: 'Juan Dela Cruz', s: 'Cleaning', t: '9:00', paid: true },
      { n: 'Ana Reyes', s: 'Filling · #36', t: '9:45', paid: false },
    ],
  },
];
---

<div
  class="absolute inset-0 flex flex-col bg-stone-50 text-stone-800 select-none"
  role="img"
  aria-label="Illustration of the D-Touch front-desk status board, sample data"
>
  <div class="flex items-center gap-3 border-b border-stone-200 bg-white px-4 py-2.5">
    <span class="grid size-6 place-items-center rounded-md bg-teal-700 text-[10px] font-bold text-white">+</span>
    <p class="text-[12px] font-bold">Front desk</p>
    <p class="text-[10px] text-stone-400">Thursday, 16 October</p>
    <span class="ml-auto rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800">Sample data</span>
    <span class="rounded-md bg-teal-700 px-2.5 py-1 text-[10px] font-semibold text-white">+ Walk-in</span>
  </div>
  <div class="grid flex-1 grid-cols-4 gap-2.5 p-3">
    {
      columns.map((c) => (
        <section class="flex min-w-0 flex-col rounded-xl bg-stone-100/80 p-2">
          <h4 class:list={['mb-2 flex items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold', c.tone]}>
            {c.title}
            <span>{c.cards.length}</span>
          </h4>
          <ul class="space-y-1.5">
            {c.cards.map((card) => (
              <li
                class:list={[
                  'rounded-lg border bg-white p-2 shadow-[0_1px_2px_rgba(0,0,0,0.05)]',
                  'active' in card && card.active ? 'border-teal-300 ring-2 ring-teal-100' : 'border-stone-200',
                ]}
              >
                <p class="flex justify-between gap-1 text-[10px]">
                  <b class="truncate">{card.n}</b>
                  <span class="shrink-0 font-mono text-stone-400">{card.t}</span>
                </p>
                <p class="truncate text-[9px] text-stone-500">{card.s}</p>
                {'late' in card && <p class="mt-1 text-[9px] font-semibold text-amber-700">{card.late}</p>}
                {'paid' in card && (
                  <p class:list={['mt-1 text-[9px] font-semibold', card.paid ? 'text-emerald-600' : 'text-rose-600']}>
                    {card.paid ? 'Paid · GCash' : 'Balance ₱1,500'}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
