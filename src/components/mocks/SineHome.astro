---
// Drawn Sine home screen on a TV: continue watching and sources. Illustration with made-up titles.

const continueRow = [
  { title: 'The Long Monsoon', meta: '2160p · Dolby Vision · Atmos', progress: 62, hue: '200 60% 30%', focus: true },
  { title: 'Harbor Lights', meta: 'S02E05 · from Jellyfin', progress: 18, hue: '18 70% 34%' },
  { title: 'Salt and Stone', meta: '1080p · DTS-HD MA', progress: 84, hue: '150 40% 26%' },
  { title: 'Night Ferry', meta: 'S01E02 · from Plex', progress: 40, hue: '265 40% 32%' },
];
const sources = [
  { name: 'USB drive', note: 'SanDisk · 412 GB' },
  { name: 'Media NAS', note: 'SMB 3' },
  { name: 'Jellyfin', note: 'Living room server' },
  { name: 'Plex', note: 'Linked' },
  { name: 'WebDAV', note: 'Cloud backup' },
  { name: 'DLNA', note: '2 servers found' },
];
const nav = ['Home', 'Browse', 'Network', 'Settings'];
---

<div class="s" role="img" aria-label="Illustration of the Sine home screen on a TV with a continue watching row and media sources, sample data">
  <aside>
    <span class="logo"><i></i>Sine</span>
    <ul>
      {nav.map((n, i) => <li class:list={[i === 0 && 'on']}>{n}</li>)}
    </ul>
    <span class="clock">8:42 PM</span>
  </aside>
  <main>
    <p class="h">Continue watching</p>
    <ul class="row">
      {
        continueRow.map((c) => (
          <li class:list={['card', c.focus && 'focus']}>
            <span class="art" style={`--h:${c.hue}`}>
              <b>{c.title}</b>
            </span>
            <span class="bar">
              <i style={`width:${c.progress}%`} />
            </span>
            <span class="meta">{c.meta}</span>
          </li>
        ))
      }
    </ul>
    <p class="h">Sources</p>
    <ul class="src">
      {
        sources.map((s) => (
          <li>
            <b>{s.name}</b>
            <span>{s.note}</span>
          </li>
        ))
      }
    </ul>
  </main>
  <span class="tag">Sample data</span>
</div>

<style>
  .s {
    position: absolute;
    inset: 0;
    display: flex;
    font-family: 'Inter', system-ui, sans-serif;
    color: #f4f1ea;
    background: radial-gradient(80% 70% at 70% 0%, #2a2018 0%, #0e0d10 60%);
  }
  aside {
    width: 168px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 32px 22px;
    border-right: 1px solid rgb(255 255 255 / 0.06);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .logo i {
    width: 26px;
    height: 19px;
    border-radius: 4px;
    background: #f5c451;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 0, 38% 26%, 38% 74%, 68% 50%, 38% 26%, 0 0);
  }
  aside ul {
    display: grid;
    gap: 6px;
    font-size: 15px;
    color: #a9a3b0;
  }
  aside li {
    padding: 9px 12px;
    border-radius: 10px;
  }
  aside li.on {
    color: #0e0d10;
    font-weight: 600;
    background: #f5c451;
  }
  .clock {
    margin-top: auto;
    font-size: 13px;
    color: #a9a3b0;
  }
  main {
    flex: 1;
    min-width: 0;
    padding: 30px 0 0 34px;
  }
  .h {
    margin-bottom: 14px;
    font-size: 17px;
    font-weight: 600;
  }
  .row {
    display: flex;
    gap: 18px;
    margin-bottom: 34px;
  }
  .card {
    flex: none;
    width: 232px;
    transition: transform 0.2s;
  }
  .art {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 130px;
    padding: 12px;
    border-radius: 12px;
    background:
      radial-gradient(90% 80% at 75% 20%, hsl(var(--h) / 0.9), transparent 70%),
      linear-gradient(160deg, hsl(var(--h)), #121015);
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .card.focus {
    transform: scale(1.06);
    transform-origin: left center;
  }
  .card.focus .art {
    box-shadow:
      0 0 0 3px #f5c451,
      0 16px 30px -12px rgb(0 0 0 / 0.8);
  }
  .bar {
    display: block;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.12);
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: #f5c451;
  }
  .meta {
    display: block;
    margin-top: 7px;
    font-size: 12px;
    color: #a9a3b0;
  }
  .src {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-right: 34px;
  }
  .src li {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    font-size: 15px;
  }
  .src span {
    font-size: 12px;
    color: #a9a3b0;
  }
  .tag {
    position: absolute;
    right: 16px;
    bottom: 12px;
    font-size: 11px;
    color: rgb(255 255 255 / 0.35);
  }
</style>
