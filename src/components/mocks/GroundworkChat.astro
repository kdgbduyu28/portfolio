---
// Drawn Groundwork chat: a cited, verified answer next to the live agent trace.
// Narrow containers (a phone) stack the trace above the answer as a compact strip.

const trace = [
  { n: 'triage', t: '0.4s' },
  { n: 'retrieve', t: '0.9s' },
  { n: 'grade', t: '1.2s', note: 'sufficient' },
  { n: 'write', t: '3.1s' },
  { n: 'verify', t: '1.0s', note: '4/4 claims' },
];
---

<div class="@container absolute inset-0 overflow-hidden bg-[#0f0d24] text-indigo-50 select-none" role="img" aria-label="Illustration of the Groundwork chat answering with citations and a verified badge">
  <div class="flex h-full">
    <div class="flex min-w-0 flex-1 flex-col gap-3 p-4 pb-[18cqw] @xl:pb-4">
      <!-- compact trace for narrow screens -->
      <ol class="flex flex-wrap gap-1 @xl:hidden">
        {
          trace.map((s) => (
            <li class="rounded-full bg-indigo-500/15 px-2 py-0.5 font-mono text-[9px] text-indigo-200">
              ✓ {s.n}
            </li>
          ))
        }
      </ol>
      <p class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-indigo-500 px-3 py-2 text-[12px]">
        Does <code class="font-mono">AsyncPostgresSaver</code> support async graphs?
      </p>
      <div class="max-w-[92%] rounded-2xl rounded-bl-md bg-white/[0.06] px-3 py-2.5 text-[12px] leading-relaxed ring-1 ring-white/10">
        <p>
          Yes. Use <code class="rounded bg-white/10 px-1 font-mono text-[11px]">AsyncPostgresSaver</code> with async graph methods like
          <code class="rounded bg-white/10 px-1 font-mono text-[11px]">ainvoke</code>
          <sup class="ml-0.5 rounded bg-indigo-400/25 px-1 font-mono text-[9px] text-indigo-100">1</sup>, and call
          <code class="rounded bg-white/10 px-1 font-mono text-[11px]">setup()</code> once to create its tables
          <sup class="rounded bg-indigo-400/25 px-1 font-mono text-[9px] text-indigo-100">2</sup>.
        </p>
        <div class="mt-2.5 flex flex-wrap gap-1.5 text-[10px]">
          <span class="rounded-full bg-emerald-500/15 px-2 py-0.5 font-semibold text-emerald-300">✓ Verified · 4/4 claims</span>
          <span class="rounded-full bg-white/5 px-2 py-0.5 text-indigo-200">[1] Persistence › Checkpointers</span>
          <span class="rounded-full bg-white/5 px-2 py-0.5 text-indigo-200">[2] Postgres saver › Setup</span>
        </div>
      </div>
      <div class="mt-auto flex items-center gap-2 rounded-xl bg-white/5 px-3 py-2 text-[11px] text-indigo-200/60 ring-1 ring-white/10">
        Ask about LangGraph…
        <span class="ml-auto grid size-6 place-items-center rounded-lg bg-indigo-500 text-white">↑</span>
      </div>
    </div>

    <!-- full trace for wide screens -->
    <aside class="hidden w-[38%] shrink-0 border-l border-white/10 p-4 @xl:block">
      <p class="mb-3 font-mono text-[10px] tracking-widest text-indigo-300/70 uppercase">Agent trace</p>
      <ol class="relative space-y-2 border-l border-indigo-400/30 pl-3">
        {
          trace.map((s, i) => (
            <li class="trace-step relative" style={`animation-delay:${i * 0.5}s`}>
              <span class="absolute top-1.5 -left-[16.5px] size-2 rounded-full bg-indigo-400" />
              <p class="flex justify-between font-mono text-[11px]">
                <span>{s.n}</span>
                <span class="text-indigo-300/60">{s.t}</span>
              </p>
              {s.note && <p class="text-[10px] text-emerald-300">{s.note}</p>}
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</div>

<style>
  .trace-step {
    animation: step 5s ease-out infinite both;
  }
  @keyframes step {
    0% {
      opacity: 0.25;
    }
    10%,
    100% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace-step {
      animation: none;
    }
  }
</style>
