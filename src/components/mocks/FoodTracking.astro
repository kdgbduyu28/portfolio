---
// Drawn customer-app screen: live order tracking. Illustration with made-up data, not the client's UI.
---

<div class="m" role="img" aria-label="Illustration of a customer app tracking a delivery: arriving in 8 minutes, sample data">
  <div class="map">
    <span class="tag">Sample data</span>
    <svg viewBox="0 0 390 420" preserveAspectRatio="xMidYMid slice" class="streets" aria-hidden="true">
      <rect width="390" height="420" fill="#eef1ec" />
      <path d="M-10 90h420M-10 250h420M-10 360h420M70-10v440M210-10v440M320-10v440" stroke="#fff" stroke-width="16" />
      <path d="M-10 170h420M140-10v440M260-10v440" stroke="#fff" stroke-width="8" />
      <rect x="150" y="100" width="50" height="60" rx="8" fill="#d6ead3" />
      <rect x="275" y="265" width="40" height="85" rx="8" fill="#d6ead3" />
      <rect x="80" y="260" width="55" height="40" rx="6" fill="#e3e0f0" />
      <path d="M95 330 H210 V170 H320 V95" fill="none" stroke="#c2410c" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M95 330 H210 V170 H320 V95" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
      <g font-size="15" text-anchor="middle">
        <circle cx="95" cy="330" r="16" fill="#fff" />
        <text x="95" y="335">🍔</text>
        <circle cx="320" cy="95" r="16" fill="#fff" />
        <text x="320" y="100">🏠</text>
      </g>
      <g class="rider">
        <circle r="22" fill="#c2410c" opacity=".2" />
        <circle r="15" fill="#c2410c" />
        <text y="5" font-size="15" text-anchor="middle">🛵</text>
        <animateMotion dur="7s" repeatCount="indefinite" calcMode="spline" keyPoints="0;1;1" keyTimes="0;0.8;1" keySplines="0.4 0 0.2 1;0 0 1 1" path="M95 330 H210 V170 H320 V95" />
      </g>
    </svg>
  </div>

  <div class="sheet">
    <span class="handle"></span>
    <p class="eta-label">Arriving in</p>
    <p class="eta">8 min</p>
    <ol class="steps">
      <li class="done">Confirmed</li>
      <li class="done">Preparing</li>
      <li class="done">Picked up</li>
      <li>Arriving</li>
    </ol>
    <div class="rider-row">
      <span class="avatar">S</span>
      <span class="who"><b>Sam</b> is on the way<small>Rider · 4.9 ★</small></span>
      <span class="act">📞</span>
      <span class="act">💬</span>
    </div>
    <div class="paid">
      <span>Campus Grill · 2 items</span>
      <span class="split"><em>Meal plan $9.50</em><em>Card $4.25</em></span>
    </div>
  </div>
</div>

<style>
  .m {
    position: absolute;
    inset: 0;
    font-size: 4.1026cqw;
    font-family: 'Inter', system-ui, sans-serif;
    color: #16140f;
    background: #fff;
  }
  .map {
    position: relative;
    height: 53%;
    overflow: hidden;
  }
  .streets {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tag {
    position: absolute;
    z-index: 2;
    top: 0.8em;
    left: 0.9em;
    padding: 0.25em 0.6em;
    border-radius: 1em;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.65em;
    font-weight: 700;
  }
  .sheet {
    position: relative;
    margin-top: -1.2em;
    height: calc(47% + 1.2em);
    padding: 0.6em 1.25em 0;
    border-radius: 1.4em 1.4em 0 0;
    background: #fff;
    box-shadow: 0 -0.4em 1.2em rgb(0 0 0 / 0.08);
  }
  .handle {
    display: block;
    width: 2.4em;
    height: 0.3em;
    margin: 0 auto 0.8em;
    border-radius: 1em;
    background: #e5e5e5;
  }
  .eta-label {
    font-size: 0.8em;
    color: #78716c;
  }
  .eta {
    font-size: 2.1em;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.3em;
    margin: 0.8em 0 1em;
    font-size: 0.62em;
    color: #a8a29e;
  }
  .steps li::before {
    content: '';
    display: block;
    height: 0.4em;
    margin-bottom: 0.45em;
    border-radius: 1em;
    background: #e7e5e4;
  }
  .steps li.done {
    color: #44403c;
  }
  .steps li.done::before {
    background: #c2410c;
  }
  .steps li:last-child::before {
    background: linear-gradient(90deg, #c2410c 40%, #e7e5e4 40%);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.5;
    }
  }
  .rider-row {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.75em 0;
    border-block: 1px solid #f0efed;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    background: #ffedd5;
    color: #c2410c;
    font-weight: 800;
  }
  .who {
    flex: 1;
    font-size: 0.85em;
    line-height: 1.3;
  }
  .who small {
    display: block;
    font-size: 0.85em;
    color: #78716c;
  }
  .act {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: #f5f5f4;
    font-size: 0.85em;
  }
  .paid {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding-top: 0.75em;
    font-size: 0.78em;
    color: #57534e;
  }
  .split {
    display: flex;
    gap: 0.4em;
  }
  .split em {
    padding: 0.3em 0.6em;
    border-radius: 0.5em;
    background: #f5f5f4;
    font-style: normal;
    font-weight: 600;
    color: #16140f;
  }
  @media (prefers-reduced-motion: reduce) {
    .steps li:last-child::before {
      animation: none;
    }
  }
</style>

<script>
  // SVG motion can't be switched off from CSS, so pause it for people who prefer less motion.
  const still = () => {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<SVGSVGElement>('.m svg.streets').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(4);
    });
  };
  document.addEventListener('astro:page-load', still);
</script>
