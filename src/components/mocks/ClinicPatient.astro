---
// Drawn D-Touch patient-app screen: booking a visit. Made-up clinic, dates and slots.

const days = [
  { d: 'Mon', n: 20 },
  { d: 'Tue', n: 21 },
  { d: 'Wed', n: 22, on: true },
  { d: 'Thu', n: 23 },
  { d: 'Fri', n: 24 },
];
const slots = [
  { t: '9:00', s: 'taken' },
  { t: '9:45', s: '' },
  { t: '10:30', s: 'taken' },
  { t: '11:15', s: 'on' },
  { t: '1:00', s: '' },
  { t: '1:45', s: '' },
  { t: '2:30', s: 'taken' },
  { t: '3:15', s: '' },
  { t: '4:00', s: '' },
];
---

<div class="m" role="img" aria-label="Illustration of the D-Touch patient app booking a cleaning, sample data">
  <header>
    <span class="logo">+</span>
    <div>
      <p class="clinic">Sample Dental Clinic</p>
      <p class="muted">Main branch · Open today</p>
    </div>
  </header>

  <h3>Book a visit</h3>
  <div class="chips">
    <span class="on">Cleaning</span><span>Check-up</span><span>Filling</span><span>Braces</span>
  </div>

  <p class="label">October</p>
  <div class="days">
    {
      days.map((x) => (
        <span class:list={{ on: x.on }}>
          <small>{x.d}</small>
          {x.n}
        </span>
      ))
    }
  </div>

  <p class="label">Available times</p>
  <div class="slots">{slots.map((x) => <span class={x.s}>{x.t}</span>)}</div>

  <div class="summary">
    <div>
      <p><b>Cleaning</b> · 45 min</p>
      <p class="muted">Wed 22 Oct, 11:15 AM · Dr. Reyes</p>
    </div>
    <span class="price">₱1,200</span>
  </div>
  <button type="button" tabindex="-1">Confirm booking</button>
  <span class="tag">Sample data</span>
</div>

<style>
  .m {
    position: absolute;
    inset: 0;
    padding: 0 1.25em;
    font-size: 4.1026cqw;
    font-family: 'Inter', system-ui, sans-serif;
    color: #1c1917;
    background: #fbfaf8;
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.5em 0 1em;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 0.6em;
    background: #0f766e;
    color: #fff;
    font-weight: 800;
  }
  .clinic {
    font-weight: 700;
    font-size: 0.95em;
  }
  .muted {
    font-size: 0.72em;
    color: #78716c;
  }
  h3 {
    font-size: 1.45em;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .chips {
    display: flex;
    gap: 0.4em;
    margin: 0.7em 0 1.1em;
    font-size: 0.78em;
    font-weight: 600;
  }
  .chips span {
    padding: 0.45em 0.8em;
    border-radius: 2em;
    background: #f0efed;
  }
  .chips .on {
    background: #0f766e;
    color: #fff;
  }
  .label {
    margin-bottom: 0.5em;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a8a29e;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.45em;
    margin-bottom: 1.1em;
  }
  .days span {
    display: grid;
    place-items: center;
    padding: 0.5em 0;
    border-radius: 0.9em;
    background: #fff;
    box-shadow: inset 0 0 0 1px #ecebe8;
    font-weight: 700;
  }
  .days small {
    font-size: 0.65em;
    font-weight: 500;
    color: #78716c;
  }
  .days .on {
    background: #0f766e;
    color: #fff;
    box-shadow: none;
  }
  .days .on small {
    color: #ccfbf1;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45em;
    font-size: 0.82em;
    font-weight: 600;
  }
  .slots span {
    padding: 0.65em 0;
    border-radius: 0.7em;
    background: #fff;
    box-shadow: inset 0 0 0 1px #ecebe8;
    text-align: center;
  }
  .slots .taken {
    color: #d6d3d1;
    text-decoration: line-through;
    box-shadow: none;
    background: #f5f5f4;
  }
  .slots .on {
    background: #ccfbf1;
    color: #115e59;
    box-shadow: inset 0 0 0 1.5px #0f766e;
  }
  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.2em;
    padding: 0.8em 0.9em;
    border-radius: 0.9em;
    background: #fff;
    box-shadow: inset 0 0 0 1px #ecebe8;
    font-size: 0.85em;
  }
  .price {
    font-weight: 800;
  }
  button {
    width: 100%;
    margin-top: 0.8em;
    padding: 0.85em;
    border: 0;
    border-radius: 0.9em;
    background: #0f766e;
    color: #fff;
    font: inherit;
    font-weight: 700;
  }
  .tag {
    position: absolute;
    top: 0.6em;
    right: 1.25em;
    padding: 0.25em 0.6em;
    border-radius: 1em;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.65em;
    font-weight: 700;
  }
</style>
