---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
const initials = SITE.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-lg bg-ink font-mono text-xs text-paper transition group-hover:bg-accent"
        aria-hidden="true">{initials}</span
      >
      {SITE.name}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm font-medium transition hover:bg-line/60',
              isActive(item.href) ? 'text-ink' : 'text-muted',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full border border-line text-muted transition hover:border-ink hover:text-ink"
        aria-label="Toggle dark mode"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path></svg
        >
      </button>
      {
        SITE.resume && (
          <a href={SITE.resume} target="_blank" rel="noopener" class="btn-ghost hidden lg:inline-flex">
            Résumé
          </a>
        )
      }
      <a href="/contact" class="btn-primary hidden sm:inline-flex">Get in touch</a>
    </div>
  </div>
</header>

<script>
  // Bound on every page load: with page transitions, the header is swapped in fresh each time.
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    });
  });
</script>
