---
import HomeScreen from './HomeScreen.astro';
import Platforms from '../Platforms.astro';
import type { Project } from '../../data/projects';
import { SITE } from '../../data/site';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const platforms = [
  { label: 'App Store', icon: 'iOS' as const },
  { label: 'Google Play', icon: 'Android' as const },
  { label: 'Web', icon: 'Web' as const },
];
---

<section class="stage relative overflow-hidden" data-stage>
  <div class="stage-bg" aria-hidden="true"></div>
  <div class="wrap relative grid items-center gap-12 pt-12 pb-16 lg:grid-cols-[1.1fr_1fr] lg:gap-6 lg:pt-16 lg:pb-24">
    <div class="text-white">
      <p class="pill">
        <span class="relative flex size-2"
          ><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60"></span><span
            class="relative inline-flex size-2 rounded-full bg-emerald-400"></span></span
        >
        {SITE.availability}
      </p>
      <h1 class="h-display mt-6 text-[2.75rem] leading-[1.02] sm:text-6xl lg:text-[4.4rem]">
        Mobile apps people open every day.
        <span class="block text-white/45">And everything behind them.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/70">
        I'm Tim, a mobile and full-stack engineer in the Philippines. I ship Flutter and React Native apps to the App
        Store, Google Play and the web, with the AWS and Postgres backends that run them.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="btn bg-white text-stone-900 hover:bg-accent hover:text-white">See my apps</a>
        {
          SITE.resume && (
            <a href={SITE.resume} target="_blank" rel="noopener" class="btn border border-white/20 text-white hover:border-white">
              Résumé
            </a>
          )
        }
        {
          SITE.portfolio && (
            <a href={SITE.portfolio} target="_blank" rel="noopener" class="btn text-white/70 hover:text-white">
              Portfolio PDF ↗
            </a>
          )
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-white/60">
        <span class="font-mono text-[11px] tracking-[0.14em] uppercase">Shipped to</span>
        {
          platforms.map((pl) => (
            <span class="inline-flex items-center gap-1.5 text-white/85">
              <Platforms platforms={[pl.icon]} class="!text-white/85" />
              {pl.label}
            </span>
          ))
        }
      </div>

      <dl class="mt-8 grid max-w-lg grid-cols-4 gap-4 border-t border-white/10 pt-6">
        {
          [
            ['15k+', 'orders'],
            ['9', 'campuses'],
            ['4', 'native apps'],
            ['4+', 'years'],
          ].map(([v, l]) => (
            <div>
              <dd class="h-display text-2xl text-white sm:text-3xl">
                {v}
              </dd>
              <dt class="mt-0.5 text-xs text-white/50">{l}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative">
      <HomeScreen projects={projects} />
    </div>
  </div>
</section>

<style>
  .stage {
    background: #0a0a0c;
    color-scheme: dark;
  }
  .stage-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 50% at 78% 45%, rgb(99 102 241 / 0.28), transparent 70%),
      radial-gradient(35% 40% at 92% 85%, rgb(244 63 94 / 0.18), transparent 70%),
      radial-gradient(30% 35% at 10% 0%, rgb(13 148 136 / 0.22), transparent 70%);
  }
  .stage-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(70% 70% at 50% 40%, #000, transparent);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.75);
    font-size: 0.78rem;
    font-weight: 500;
  }
</style>
