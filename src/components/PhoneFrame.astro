---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A phone showing a real screenshot of the app. "Try it live" swaps the screenshot for the
// running app in an iframe, so visitors use the real thing without the page loading it up front.

interface Props {
  url: string;
  title: string;
  screenshot?: ImageMetadata;
  accent?: string;
  eager?: boolean;
}

const { url, title, screenshot, accent = '#16140f', eager = false } = Astro.props;
---

<div class="phone mx-auto w-full max-w-[300px]" data-phone data-src={url} style={`--phone-accent:${accent}`}>
  <div class="relative rounded-[2.6rem] bg-[#1b1b1d] p-[10px] shadow-[0_30px_60px_-25px_rgba(0,0,0,0.45)] ring-1 ring-black/10 dark:ring-white/10">
    <div class="absolute top-[18px] left-1/2 z-20 h-[22px] w-[84px] -translate-x-1/2 rounded-full bg-black"></div>
    <div class="relative aspect-[390/844] overflow-hidden rounded-[2rem] bg-white">
      {
        screenshot && (
          <Image
            src={screenshot}
            alt={`${title} home screen`}
            widths={[300, 600]}
            sizes="300px"
            loading={eager ? 'eager' : 'lazy'}
            class="absolute inset-0 size-full object-cover object-top"
            data-phone-poster
          />
        )
      }
      <div class="absolute inset-x-0 bottom-0 z-10 flex justify-center bg-gradient-to-t from-black/55 to-transparent p-5 pt-16" data-phone-cta>
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-stone-900 shadow-lg transition hover:scale-[1.03]"
          data-phone-load
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full opacity-75" style="background:var(--phone-accent)"
            ></span>
            <span class="relative inline-flex size-2 rounded-full" style="background:var(--phone-accent)"></span>
          </span>
          Try it live
        </button>
      </div>
    </div>
  </div>
  <p class="mt-3 text-center text-xs text-muted">
    The real app, running in the frame. <a class="font-medium whitespace-nowrap text-ink underline underline-offset-4" href={url} target="_blank" rel="noopener"
      >Open full screen ↗</a
    >
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-phone]').forEach((phone) => {
    phone.querySelector('[data-phone-load]')?.addEventListener('click', () => {
      const screen = phone.querySelector('[data-phone-cta]')?.parentElement;
      if (!screen || screen.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src = phone.dataset.src!;
      frame.title = 'Live app';
      frame.className = 'absolute inset-0 z-0 size-full border-0 bg-white opacity-0 transition-opacity duration-300';
      frame.allow = 'clipboard-write; geolocation';
      screen.appendChild(frame);
      phone.querySelector<HTMLButtonElement>('[data-phone-load]')!.textContent = 'Loading…';
      // Keep the screenshot until the app has painted, then drop it and the button.
      frame.addEventListener('load', () => {
        frame.classList.remove('opacity-0');
        screen.querySelector('[data-phone-poster]')?.remove();
        screen.querySelector('[data-phone-cta]')?.remove();
      });
    });
  });
</script>
