---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ClinicMock from './ClinicMock.astro';
import AgentGraph from './AgentGraph.astro';

// The picture at the top of a project card: a cropped screenshot or a drawn mock-up on the project's colour.

interface Props {
  project: CollectionEntry<'projects'>;
}

const { data } = Astro.props.project;
---

<div
  class="relative aspect-[16/11] overflow-hidden"
  style={`background: radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, ${data.accent} 55%, white) 0%, ${data.accent} 60%, color-mix(in oklab, ${data.accent} 70%, black) 100%)`}
>
  {
    data.screenshot ? (
      <div class="absolute top-[12%] left-1/2 w-[46%] -translate-x-1/2 rotate-[-4deg] transition duration-500 group-hover:rotate-0 group-hover:-translate-y-2">
        <div class="rounded-[1.4rem] bg-[#1b1b1d] p-[6px] shadow-2xl">
          <Image
            src={data.screenshot}
            alt=""
            widths={[240, 480]}
            sizes="240px"
            class="aspect-[390/844] w-full rounded-[1.1rem] object-cover object-top"
          />
        </div>
      </div>
    ) : data.demo.kind === 'clinic-mock' ? (
      <div class="absolute top-[12%] left-[7%] w-[120%] origin-top-left transition duration-500 group-hover:-translate-y-2">
        <ClinicMock variant="cover" />
      </div>
    ) : data.demo.kind === 'agent-graph' ? (
      <div class="absolute inset-x-[6%] top-1/2 -translate-y-1/2 transition duration-500 group-hover:scale-[1.03]">
        <AgentGraph />
      </div>
    ) : null
  }
</div>
