---
// The phone status bar: 9:41, signal, wifi and battery.

interface Props {
  bg?: string;
  fg?: string;
}

const { bg = 'transparent', fg = '#0b0b0c' } = Astro.props;
---

<div class="phone-status" style={`background:${bg};color:${fg}`} aria-hidden="true">
  <span class="phone-time">9:41</span>
  <span class="phone-icons">
    <svg viewBox="0 0 18 12" fill="currentColor">
      <rect x="0" y="8" width="3" height="4" rx="1" />
      <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
      <rect x="10" y="3" width="3" height="9" rx="1" />
      <rect x="15" y="0" width="3" height="12" rx="1" />
    </svg>
    <svg viewBox="0 0 16 12" fill="currentColor">
      <path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.2-1.3A10.2 10.2 0 0 0 8 .8 10.2 10.2 0 0 0 .8 3.7L2 5c1.6-1.5 3.7-2.4 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.3l1.2-1.3A6.6 6.6 0 0 0 8 4.4c-1.8 0-3.4.7-4.6 1.8l1.2 1.3c.9-.8 2.1-1.3 3.4-1.3Zm0 3.6c.4 0 .8.2 1.1.4L8 11.6 6.9 10.2c.3-.2.7-.4 1.1-.4Z" />
    </svg>
    <svg viewBox="0 0 27 12" fill="none">
      <rect x=".5" y=".5" width="23" height="11" rx="3.5" stroke="currentColor" opacity=".4" />
      <rect x="2" y="2" width="19" height="8" rx="2" fill="currentColor" />
      <path d="M25 4v4c.8-.3 1.3-1.1 1.3-2S25.8 4.3 25 4Z" fill="currentColor" opacity=".5" />
    </svg>
  </span>
</div>

<style>
  .phone-status {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 12.8cqw;
    padding: 2.2cqw 7.5cqw 0 9cqw;
    font:
      600 4cqw/1 -apple-system,
      'Inter',
      system-ui,
      sans-serif;
  }
  .phone-icons {
    display: flex;
    gap: 1.4cqw;
    align-items: center;
  }
  .phone-icons svg {
    height: 3cqw;
    width: auto;
  }
</style>
