---
// A landscape tablet. The screen is a size container, so drawn screens can use container queries.

interface Props {
  class?: string;
  glow?: string;
}

const { class: className, glow } = Astro.props;
---

<div class:list={['tablet', className]} style={glow ? `--tablet-glow:${glow}` : undefined}>
  <div class="tablet-frame">
    <div class="tablet-screen">
      <div class="tablet-canvas" data-fit="1024">
        <slot />
      </div>
    </div>
    <span class="tablet-cam" aria-hidden="true"></span>
  </div>
</div>

<style>
  .tablet {
    container-type: inline-size;
    position: relative;
    width: 100%;
  }
  .tablet::before {
    content: '';
    position: absolute;
    inset: 10% 4% -3%;
    z-index: -1;
    border-radius: 12%;
    background: var(--tablet-glow, transparent);
    filter: blur(8cqw);
    opacity: 0.3;
  }
  .tablet-frame {
    position: relative;
    padding: 2.2cqw;
    border-radius: 4.6cqw;
    background: linear-gradient(145deg, #3a3a3e, #141416 45%, #232327);
    box-shadow:
      inset 0 0 0 0.35cqw #4a4a50,
      0 3cqw 7cqw -2cqw rgb(0 0 0 / 0.5);
  }
  .tablet-screen {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1180 / 820;
    overflow: hidden;
    border-radius: 2.6cqw;
    background: #f5f5f4;
  }
  /* Screens are drawn at 1024×712 (the frame's aspect) and scaled to fit, like a real screenshot. */
  .tablet-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1024px;
    height: 712px;
    transform-origin: 0 0;
    transform: scale(var(--fit, 0.5));
  }
  .tablet-cam {
    position: absolute;
    top: 50%;
    left: 1.1cqw;
    width: 0.7cqw;
    height: 0.7cqw;
    translate: 0 -50%;
    border-radius: 50%;
    background: #0b0b0c;
  }
</style>

